# Токен чат-бота MAX (выдаётся организаторами / Master Bot). Никогда не коммитьте настоящий токен.
BOT_TOKEN=
# Публичный HTTPS-адрес мини-приложения — тот же, что указан в настройках бота на платформе MAX для партнёров.
MINIAPP_URL=
# Ник бота для кнопки «Открыть приложение»; если пусто — определяется автоматически.
BOT_USERNAME=
# Включить чат-бота (long polling). false — только API и мини-приложение.
BOT_ENABLED=true
# Порт на хосте для docker compose.
HOST_PORT=8080
# Демо-режим напоминаний: первое напоминание через N секунд после отчёта (0 — за день до срока).
REMINDER_DEMO_SECONDS=60
# Только для локальной разработки вне MAX: разрешает заголовок X-Dev-User. В проде — false.
DEV_AUTH=false
