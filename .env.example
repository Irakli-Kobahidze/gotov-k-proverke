# Токен чат-бота MAX (обязательно)
BOT_TOKEN=
# Публичный HTTPS-адрес мини-приложения. Тот же адрес должен быть привязан к боту в MAX.
# Пример: https://gotov-k-proverke-caxar010123.amvera.io (без / на конце)
MINIAPP_URL=
# Ник бота для кнопки «Открыть приложение». Если пусто — определяется автоматически.
BOT_USERNAME=
# false — запустить только API и мини-приложение, без бота
BOT_ENABLED=true
# Порт на хосте для docker compose
HOST_PORT=8080
# Домен для автоматического HTTPS через Caddy (профиль https), например 77-222-32-252.sslip.io
DOMAIN=
# Для демонстрации: первое напоминание через N секунд после отчёта. 0 — за сутки до срока.
REMINDER_DEMO_SECONDS=60
# Только для разработки вне MAX: вход через заголовок X-Dev-User. На сервере всегда false.
DEV_AUTH=false
